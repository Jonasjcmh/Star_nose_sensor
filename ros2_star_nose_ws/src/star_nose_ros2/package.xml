<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>star_nose_ros2</name>
  <version>0.0.1</version>
  <description>ROS2 integration for the 19-point KYWO tactile sensor + UR5 calibration/indentation rig (UI, UR5 driver, data logging nodes).</description>
  <maintainer email="djdivyajoshi774@gmail.com">divuthejo</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
